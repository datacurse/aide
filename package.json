{
  "name": "aide",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @aide/web dev",
    "deploy-agent": "pnpm --filter @aide/daemon deploy-agent",
    "probe": "pnpm --filter @aide/daemon probe",
    "smoke": "pnpm --filter @aide/daemon smoke",
    "smoke:queue": "pnpm --filter @aide/daemon smoke:queue",
    "commit-force": "node scripts/aide-commit-force.mjs",
    "daemon": "pnpm --filter @aide/daemon start",
    "web": "pnpm --filter @aide/web dev",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm --filter @aide/web build"
  }
}
